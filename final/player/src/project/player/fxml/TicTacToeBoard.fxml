<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.text.Font?>

<AnchorPane maxHeight="-Infinity"
            maxWidth="-Infinity"
            minHeight="-Infinity"
            minWidth="-Infinity"
            prefHeight="600.0"
            prefWidth="600.0"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="project.player.controller.BoardController">

   <children>

      <Pane maxHeight="-Infinity"
            maxWidth="-Infinity"
            minHeight="-Infinity"
            minWidth="-Infinity"
            prefHeight="600.0"
            prefWidth="600.0">

         <children>

            <GridPane layoutX="30.0"
                      layoutY="60.0"
                      prefHeight="540.0"
                      prefWidth="540.0">

               <columnConstraints>
                  <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="180.0" />
                  <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="180.0" />
                  <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="180.0" />
               </columnConstraints>

               <rowConstraints>
                  <RowConstraints minHeight="10.0" prefHeight="180.0" vgrow="SOMETIMES" />
                  <RowConstraints minHeight="10.0" prefHeight="180.0" vgrow="SOMETIMES" />
                  <RowConstraints minHeight="10.0" prefHeight="180.0" vgrow="SOMETIMES" />
               </rowConstraints>

               <children>

                  <Pane prefHeight="180.0" prefWidth="180.0">
                     <children>
                        <Button fx:id="topLeft"
                                mnemonicParsing="false"
                                onMouseClicked="#toggleBoardButton"
                                prefHeight="180.0"
                                prefWidth="180.0">
                           <font>
                              <Font size="95.0" />
                           </font>
                        </Button>
                     </children>
                  </Pane>

                  <Pane prefHeight="180.0"
                        prefWidth="180.0"
                        GridPane.columnIndex="1">
                     <children>
                        <Button fx:id="topCenter"
                                mnemonicParsing="false"
                                onMouseClicked="#toggleBoardButton"
                                prefHeight="180.0"
                                prefWidth="180.0">
                           <font>
                              <Font size="95.0" />
                           </font>
                        </Button>
                     </children>
                  </Pane>

                  <Pane prefHeight="180.0"
                        prefWidth="180.0"
                        GridPane.columnIndex="2">
                     <children>
                        <Button fx:id="topRight"
                                mnemonicParsing="false"
                                onMouseClicked="#toggleBoardButton"
                                prefHeight="180.0"
                                prefWidth="180.0">
                           <font>
                              <Font size="95.0" />
                           </font>
                        </Button>
                     </children>
                  </Pane>

                  <Pane prefHeight="180.0"
                        prefWidth="180.0"
                        GridPane.rowIndex="1">
                     <children>
                        <Button fx:id="middleLeft"
                                mnemonicParsing="false"
                                onMouseClicked="#toggleBoardButton"
                                prefHeight="180.0"
                                prefWidth="180.0">
                           <font>
                              <Font size="95.0" />
                           </font>
                        </Button>
                     </children>
                  </Pane>

                  <Pane prefHeight="180.0"
                        prefWidth="180.0"
                        GridPane.columnIndex="1"
                        GridPane.rowIndex="1">
                     <children>
                        <Button fx:id="middleCenter"
                                mnemonicParsing="false"
                                onMouseClicked="#toggleBoardButton"
                                prefHeight="180.0"
                                prefWidth="180.0">
                           <font>
                              <Font size="95.0" />
                           </font>
                        </Button>
                     </children>
                  </Pane>

                  <Pane prefHeight="180.0"
                        prefWidth="180.0"
                        GridPane.columnIndex="2"
                        GridPane.rowIndex="1">
                     <children>
                        <Button fx:id="middleRight"
                                mnemonicParsing="false"
                                onMouseClicked="#toggleBoardButton"
                                prefHeight="180.0"
                                prefWidth="180.0">
                           <font>
                              <Font size="95.0" />
                           </font>
                        </Button>
                     </children>
                  </Pane>

                  <Pane prefHeight="180.0"
                        prefWidth="180.0"
                        GridPane.rowIndex="2">
                     <children>
                        <Button fx:id="bottomLeft"
                                mnemonicParsing="false"
                                onMouseClicked="#toggleBoardButton"
                                prefHeight="180.0"
                                prefWidth="180.0">
                           <font>
                              <Font size="95.0" />
                           </font>
                        </Button>
                     </children>
                  </Pane>

                  <Pane prefHeight="180.0"
                        prefWidth="180.0"
                        GridPane.columnIndex="1"
                        GridPane.rowIndex="2">
                     <children>
                        <Button fx:id="bottomCenter"
                                mnemonicParsing="false"
                                onMouseClicked="#toggleBoardButton"
                                prefHeight="180.0"
                                prefWidth="180.0">
                           <font>
                              <Font size="95.0" />
                           </font>
                        </Button>
                     </children>
                  </Pane>

                  <Pane prefHeight="180.0"
                        prefWidth="180.0"
                        GridPane.columnIndex="2"
                        GridPane.rowIndex="2">
                     <children>
                        <Button fx:id="bottomRight"
                                mnemonicParsing="false"
                                onMouseClicked="#toggleBoardButton"
                                prefHeight="180.0"
                                prefWidth="180.0">
                           <font>
                              <Font size="95.0" />
                           </font>
                        </Button>
                     </children>
                  </Pane>

               </children>
            </GridPane>
         </children>
      </Pane>

      <Label fx:id="turnLabel"
             layoutX="20.0"
             layoutY="10.0"
             prefHeight="40.0"
             prefWidth="200.0"
             text="X's Turn">

         <font>
            <Font size="24.0" />
         </font>

      </Label>

      <Button fx:id="leaveButton"
              layoutX="500.0"
              layoutY="10.0"
              mnemonicParsing="false"
              onAction="#handleLeaveButton"
              prefHeight="40.0"
              prefWidth="80.0"
              text="Leave" />

   </children>
</AnchorPane>
